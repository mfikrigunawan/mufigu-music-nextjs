# Salin menjadi .env.local (tidak di-commit).
# Folder musik yang bisa DITULIS. Upload CMS disimpan di subfolder _uploads.
# Lokal: folder di PC. Production: volume persisten di server (/data/music, sudah diset di Dockerfile).
MUSIC_DIR=C:\path\to\music
# Database Postgres. Lokal: jalankan `pnpm db:dev`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mufigu_music
# String acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Alamat publik situs (production), contoh https://music.mufigu.com. Lokal boleh kosong.
SERVER_URL=
